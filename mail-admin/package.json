{
  "name": "mail-admin",
  "version": "1.0.0",
  "description": "商城小程序管理后台系统",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run serve",
    "dev:backend": "nodemon server.js",
    "build": "cd frontend && npm run build",
    "start": "node server.js",
    "install:all": "npm install && cd frontend && npm install"
  },
  "keywords": [
    "mall",
    "admin",
    "management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.0.1",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  }
}
